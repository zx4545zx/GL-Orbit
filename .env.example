# Runtime provider: neon (default when omitted) or supabase
DB_PROVIDER=neon
NEON_DATABASE_URL=postgres://user:password@host.neon.tech/database?sslmode=require
NEON_READONLY_DATABASE_URL=postgres://readonly_user:password@host.neon.tech/database?sslmode=require
# Supabase runtime uses transaction pooler port 6543
SUPABASE_DATABASE_URL=postgres://user:password@host.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_READONLY_DATABASE_URL=postgres://readonly_user:password@host.pooler.supabase.com:6543/postgres?sslmode=require
# Drizzle Kit only: direct connection, never the Supabase transaction pooler
DATABASE_MIGRATION_URL=postgres://user:password@direct-host:5432/database?sslmode=require
# Legacy default-Neon compatibility only: DATABASE_URL and READONLY_DATABASE_URL
AUTH_SECRET=your-secret-key-here
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_API_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-Text-01

# External What's On news and events (server-only)
WHATS_ON_API_URL=https://your-project.supabase.co
WHATS_ON_API_KEY=your-publishable-key

# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Public VAPID key exposed to client
VITE_VAPID_PUBLIC_KEY=

# Cloudflare R2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gl-orbit-media
R2_PUBLIC_URL=https://pub-<hash>.r2.dev
